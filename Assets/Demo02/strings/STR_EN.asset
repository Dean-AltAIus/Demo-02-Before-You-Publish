  - Key: localauthority.preparepresenterdecision.scope.requestid.body.synthetic.authored.scenario
    English: 'Synthetic authored scenario: {authoredreason}'
  - Key: localauthority.preparepresenterdecision.scope.requestid.status.authored.response.ready
    English: '{decision} authored response ready'
  - Key: localauthority.preparereviewdecision.assign.string.reason.returned.after.a.structural.check.no
    English: 'Returned after a structural check: {defect} No semantic alignment judgement
      has been made.'
  - Key: localauthority.preparereviewdecision.requestid.body.a.current.accepted.schedule.is.required
    English: A current accepted schedule is required before a separate review decision.
  - Key: localauthority.preparereviewdecision.requestid.body.a.semantic.review.of.your.own
    English: A semantic review of your own task, criteria and rationale is unavailable
