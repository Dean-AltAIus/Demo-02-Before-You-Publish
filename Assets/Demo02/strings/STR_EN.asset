  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 316453ba37f247241a5bc293af777b87, type: 3}
  m_Name: STR_EN
  m_EditorClassIdentifier: 
  Entries:
  - Key: attemptlifecycle.boundedobservation.return.authored.demonstration.w.list.received.under.task.1.rubric.1.those
    English: '{value0} under Task 1 / Rubric 1. Those marks are marking hypotheses.
      They do not establish that O2 evaluation was observed. Annotation IDs: {value2}'
  - Key: attemptlifecycle.boundedobservation.return.authored.demonstration.w.list.received.value0.authored.demonstration.w.list.received.authored.demonstration.w.list.received.full
    English: 'Authored demonstration: W_LIST received full 20 draft marks'
  - Key: attemptlifecycle.boundedobservation.return.authored.demonstration.w.list.received.value0.recorded.w.list.received.your.recorded.w.list.received.your.full
    English: 'Recorded: W_LIST received your full 20 draft marks'
  - Key: attemptlifecycle.boundedobservation.return.the.most.recent.baseline.w.the.most.recent.baseline.w.list
    English: The most recent baseline W_LIST annotations do not form a complete 20-mark
      total. Earlier annotations, if any, remain in the timeline. No counterexample
      explanation or independent evaluation skill is inferred.
  - Key: attemptlifecycle.outcome.return.active.risk.recorded.incident.s
    English: 'Active risk: {s_activerisks} recorded incident(s).'
  - Key: attemptlifecycle.outcome.return.exact.current.pair.release.recorded
    English: Exact current-pair release recorded.
  - Key: attemptlifecycle.outcome.return.owned.unresolved.a.verified.defect.and
    English: 'Owned unresolved: a verified defect and actual owner acceptance are
      recorded.'
  - Key: attemptlifecycle.outcome.return.partial.practice.no.current.approved.release
    English: Partial practice. No current approved release or verified accepted hold
      is recorded.
  - Key: attemptlifecycle.outcome.return.self.owned.commitment.recorded.defect.interpretation
    English: Self-owned commitment recorded. Defect interpretation remains unverified.
  - Key: authority.details.hide
    English: Hide exact reply details
  - Key: authority.details.show
    English: View exact reply details
  - Key: authority.local.decision.disclosure
    English: Authored offline decision for the exact requested pair. No live service
      is connected.
  - Key: authority.synthetic.decision.disclosure
    English: Authored offline demonstration. This decision covers only the exact
      synthetic pair. No live service is connected.
  - Key: campusexperimentprojection.lateupdate.assign.lanes.i.marklabel.text.value0.unmarked.unmarked
    English: Unmarked
  - Key: campusexperimentprojection.lateupdate.assign.pairlabel.text.task.rubric
    English: Task {s_task_version} / Rubric {s_rubric_version}
  - Key: campusexperimentprojection.lateupdate.assign.totallabel.text.draft.hypothesis.20.unverified.draft.hypothesis.20.unverified
    English: 'Draft hypothesis

      {s_drafttotal_selected} / 20 | unverified'
  - Key: campusexperimentprojection.lateupdate.assign.totallabel.text.no.marks.assigned.no.marks.assigned
    English: No marks assigned
  - Key: campusexperimentprojection.lateupdate.assign.worklabel.text.inspected.inspected
    English: '{selected} | inspected'
  - Key: campusexperimentprojection.lateupdate.assign.worklabel.text.select.work.at.table.select.work.at.table
    English: SELECT WORK AT TABLE
  - Key: campusgameplayfacade.directroute.directroute.message.return.to.the.station.to.inspect
    English: Return to the station to inspect this passage.
  - Key: campusgameplayfacade.selectinspectedwork.selectinspectedwork.message.inspect.work.before.selecting.it
    English: Inspect work before selecting it.
  - Key: campusgameplayfacade.update.assign.worldprompt.text.e.inspect.tab.direct.routes.e.inspect.tab.direct.routes
    English: E  Inspect {station_displayname}    |    Tab  Direct routes
  - Key: campusgameplayfacade.update.assign.worldprompt.text.wasd.move.hold.right.mouse.wasd.move.hold.right.mouse.look
    English: Arrow keys  Move | Right mouse  Look | Tab  Direct routes
  - Key: conversationcontracts.initialization.return.authored.offline.reply.no.language.interpretation
    English: Authored offline reply. No language interpretation or semantic evaluation.
  - Key: conversationcoordinator.acknowledge.assign.record.error.the.prepared.reply.is.historical.because
    English: The prepared reply is historical because its version or source scope
      changed before display.
  - Key: conversationcoordinator.complete.assign.record.error.the.version.or.admitted.sources.changed
    English: The version or admitted sources changed. The original question is preserved;
      inspect the current pair before a fresh request.
  - Key: conversationcoordinator.compose.assign.answer.a.current.exact.pair.approval.a.current.exact.pair.approval.is
    English: 'A current exact-pair approval is recorded: {current_currentapproval_receiptid}.
      Inspect its scope before requesting release.'
  - Key: conversationcoordinator.compose.assign.answer.a.grounded.response.to.those.a.grounded.response.to.those.a.grounded.response.to.those.words
    English: A grounded response to those words is unavailable offline. No review
      decision or approval has been created. Use the exact-pair review controls for
      a scoped request.
  - Key: conversationcoordinator.compose.assign.answer.a.grounded.response.to.those.i.cannot.verify.that.reasoning.i.cannot.verify.that.reasoning.with
    English: I cannot verify that reasoning with this offline adapter. Your marks
      remain your hypothesis; there is no semantic finding from this reply.
  - Key: conversationcoordinator.compose.assign.answer.i.brought.the.publication.request.i.brought.the.publication.request.i
    English: I brought the publication request. I can discuss the practical context,
      but I cannot approve the task or rubric.
  - Key: conversationcoordinator.compose.assign.answer.i.cannot.interpret.that.question.i.cannot.interpret.that.question.in
    English: I cannot interpret that question in this authored offline conversation.
      Your words are preserved. I have made no change or commitment.
  - Key: conversationcoordinator.compose.assign.answer.i.own.exact.pair.publication.i.examine.recorded.work.and.i.examine.recorded.work.and.criteria
    English: I examine recorded work and criteria. My findings are separate from
      publication approval, and arbitrary free-text evaluation is unavailable offline.
  - Key: conversationcoordinator.compose.assign.answer.i.own.exact.pair.publication.i.own.exact.pair.publication.i.own.exact.pair.publication.review
    English: I own exact-pair publication review. A scheduled slot is separate from
      my decision. This local adapter cannot semantically approve arbitrary wording.
  - Key: conversationcoordinator.compose.assign.answer.no.current.exact.pair.approval.no.current.exact.pair.approval.is
    English: No current exact-pair approval is recorded. A request, a conversation
      or a total of 20 cannot supply that receipt.
  - Key: conversationcoordinator.compose.assign.answer.no.source.inspection.is.recorded.no.source.inspection.is.recorded.in
    English: No source inspection is recorded in this attempt.
  - Key: conversationcoordinator.compose.assign.answer.publication.is.due.at.14.publication.is.due.at.14.00
    English: Publication is due at 14:00. Only an accepted scheduling response changes
      the logical clock.
  - Key: conversationcoordinator.compose.assign.answer.the.notebook.records.v.opening.the.notebook.records.opening.a.source
    English: 'The notebook records: {value1}. Opening a source does not prove understanding.'
  - Key: conversationcoordinator.compose.assign.answer.the.notebook.records.v.opening.value1.item.v
    English: '{p_sourceid} v{p_version}'
  - Key: conversationcoordinator.compose.assign.answer.the.request.is.to.publish.the.request.is.to.publish.before
    English: The request is to publish before 14:00. There is no automatic time penalty
      while you read, type or think.
  - Key: conversationcoordinator.process.assign.record.error.the.local.reply.could.not.be
    English: The local reply could not be prepared. Your draft and original request
      are retained.
  - Key: conversationcoordinator.requirerole.requirerole.message.choose.a.conversation.role.not.an
    English: Choose a conversation role, not an authority or evaluator identity.
  - Key: conversationcoordinator.setdraft.setdraft.message.reconcile.or.cancel.the.original.request
    English: Reconcile or cancel the original request before sending again.
  - Key: conversationcoordinator.setdraft.setdraft.message.replay.is.read.only
    English: Replay is read-only.
  - Key: conversationcoordinator.setdraft.setdraft.message.write.a.question.before.sending
    English: Write a question before sending.
  - Key: conversationdispatchqueue.schedule.schedule.message.a.captured.pending.conversation.request.is
    English: A captured pending conversation request is required.
  - Key: helpcoordinator.assistancesummary.return.assistance.history.is.unavailable.independent.assistance.history.is.unavailable.independent.or
    English: Assistance history is unavailable. Independent or no-help status cannot
      be verified.
  - Key: helpcoordinator.assistancesummary.return.linked.practice.retains.historical.assistance.complete.local.ledger.no.help.actual.help.deliveries.recorded.strategic.actual.help.deliveries.recorded.strategic.see
    English: '{s_assistance} actual help deliveries recorded; {s_assistance_a_a_strategic}
      strategic. See delivery and opportunity IDs in the timeline.'
  - Key: helpcoordinator.assistancesummary.return.linked.practice.retains.historical.assistance.complete.local.ledger.no.help.complete.local.ledger.no.help.complete.local.ledger.no.help.has
    English: 'Complete local ledger: no help has been shown.'
  - Key: helpcoordinator.assistancesummary.return.linked.practice.retains.historical.assistance.linked.practice.retains.historical.assistance.linked.practice.retains.historical.assistance.and
    English: Linked practice retains historical assistance and is assisted practice.
  - Key: helpcoordinator.request.assign.help.text.a.grounded.strategy.response.to.your
    English: A grounded strategy response to your request is unavailable in this
      offline adapter. Your own question is retained. You can continue independently
      or inspect your recorded attempt.
  - Key: helpcoordinator.request.assign.help.text.this.attempt.records.inspected.passages.saved
    English: 'This attempt records {s_notebook} inspected passages, {s_annotationhistory}
      saved marking hypotheses and {s_audit} command records. Current grounded evaluations:
      {s_currentevaluations}. Review and assistance IDs are in the timeline. These
      records do not establish competence.'
  - Key: helpcoordinator.request.assign.help.text.wasd.moves.with.world.focus.hold
    English: Arrow keys move with world focus. Hold right mouse to look. E inspects. Tab
      opens direct routes. Enter or Space activates a button. Escape goes back. Text
      fields keep your own draft. Preview, save and publish are separate actions.
  - Key: helpcoordinator.request.assign.help.text.what.does.the.work.you.marked
    English: What does the work you marked actually demonstrate under the criterion
      you chose? Compare the actual passage with that criterion before deciding your
      next action.
  - Key: input.allocation.integer
    English: Enter whole-number marks
  - Key: input.criterion.id
    English: Enter a unique criterion ID
  - Key: input.hold.defect
    English: Describe the specific unresolved defect...
  - Key: input.hold.next
    English: Describe the owner's next action...
  - Key: input.mark.integer
    English: Enter a whole number from 0 to the maximum
  - Key: input.mark.rationale
    English: Explain your marking in your own words...
  - Key: input.outcomes
    English: Enter O1, O2 or O1,O2
  - Key: input.prose
    English: Write in your own words...
  - Key: input.question.id
    English: Enter Q1 or Q2
  - Key: input.review.summary
    English: Describe the changes you want reviewed...
  - Key: input.task.context
    English: Describe your decision context...
  - Key: input.time
    English: Enter a same-day time, HH:MM
  - Key: lane.empty
    English: 'Choose a criterion

      in the work controls.'
  - Key: lane.literal
    English: '{question} | Maximum {maximum}

      {description}'
  - Key: localauthority.acknowledge.assign.reply.status.scheduled.owner.accepted.owner.accepted.owner.accepted.owner.accepted
    English: Owner accepted
  - Key: localauthority.acknowledge.assign.reply.status.scheduled.owner.accepted.scheduled.scheduled.scheduled
    English: Scheduled
  - Key: localauthority.initialization.return.authored.offline.role.response.no.live
    English: Authored offline role response. No live service or semantic approval.
  - Key: localauthority.prepareowneracceptance.requestid.body.review.at.next.action.this.holds
    English: '{value0}Review at {hold_proposal_reviewat}. Next action: {hold_proposal_nextaction}.
      This holds the work unresolved; it is not publication approval.'
  - Key: localauthority.prepareowneracceptance.requestid.body.self.ownership.needs.your.explicit.confirmation
    English: Self-ownership needs your explicit confirmation. This is not an NPC
